{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "ProxyDb": "Server=(localdb)\\MoDSecureProxy;Database=MoDSecureProxy;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "ProxyLimits": {
    "MaxRequestBodyBytes": 2000000,
    "MaxResponseBodyBytes": 2000000
  },
  "AllowedHosts": "*"
}
